# ====================================
# Secure Image Encryption System
# Environment Configuration
# ====================================

# Copy this file to .env and update the values
# WARNING: Never commit .env to version control!

# ====================================
# Application Settings
# ====================================
NODE_ENV=development
APP_NAME="Secure Image Encryption System"
APP_VERSION=1.0.0
APP_PORT=8000
APP_HOST=0.0.0.0
APP_SECRET=change_this_to_a_secure_secret_key
APP_URL=http://localhost:8000
APP_DEBUG=true

# ====================================
# Hedera Blockchain Configuration
# ====================================
HEDERA_NETWORK=testnet  # testnet or mainnet
HEDERA_ACCOUNT_ID=0.0.12345
HEDERA_PRIVATE_KEY=302e020100300506032b657004220420...
HEDERA_TOPIC_ID=0.0.123456

# ====================================
# Database Configuration (PostgreSQL)
# ====================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secure_image
POSTGRES_SCHEMA=public
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ====================================
# Redis Configuration
# ====================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ====================================
# Email Configuration (SMTP)
# ====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false  # true for 465, false for other ports
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Secure Image System <noreply@example.com>"
SMTP_REPLY_TO=support@example.com

# ====================================
# Security Settings
# ====================================
# JWT Configuration
JWT_SECRET=change_this_to_a_secure_jwt_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true

# Session
SESSION_SECRET=change_this_session_secret
SESSION_MAX_AGE=86400000  # 1 day in ms

# ====================================
# File Storage
# ====================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# ====================================
# Logging
# ====================================
LOG_LEVEL=debug  # error, warn, info, debug, verbose
LOG_FILE=logs/app.log
LOG_FORMAT=json  # json or text
ENABLE_REQUEST_LOGGING=true

# ====================================
# CORS Configuration
# ====================================
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_CREDENTIALS=true

# ====================================
# Feature Flags
# ====================================
FEATURE_MAINTENANCE_MODE=false
FEATURE_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false

# ====================================
# External Services
# ====================================
# YOLO Model Path
YOLO_MODEL_PATH=./models/yolov8n.pt

# CDN/Storage (if using S3 or similar)
STORAGE_DRIVER=local  # local, s3, gcs, azure
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name

# ====================================
# Monitoring
# ====================================
ENABLE_METRICS=true
METRICS_ENDPOINT=/metrics
PROMETHEUS_ENABLED=true

# ====================================
# API Documentation
# ====================================
ENABLE_SWAGGER=true
SWAGGER_PATH=/api-docs
API_VERSION=v1

# ====================================
# Performance
# ====================================
REQUEST_TIMEOUT=30000  # 30 seconds
RESPONSE_COMPRESSION=true
MAX_EVENT_LOOP_DELAY=1000  # 1 second

# ====================================
# Development Settings
# ====================================
# Set to false in production
DEBUG=true
NODE_TLS_REJECT_UNAUTHORIZED=0  # Only for development, disable in production

# ====================================
# Testing
# ====================================
# Used for test environments
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/test_db
NODE_ENV=test
